/* Java owns pixel geometry; this sheet owns the supplied surfaces, glyphs and states. */
.terminal-root, .terminal-window, .terminal-glyph { background: #00000000; }
.terminal-panel { background: #FFCBCCD4; }
.frame-light { background: #FFF0F0F3; }
.frame-dark { background: #FF555970; }
.sidebar-top { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_sidebar_0.png); }
.sidebar-middle { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_sidebar_1.png); }
.sidebar-bottom { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_sidebar_2.png); }

.terminal-label, .terminal-control .__button_text__ {
    font-size: 7;
    text-color: #FF343548;
    text-shadow: false;
    adaptive-width: false;
    adaptive-height: false;
    horizontal-align: center;
    vertical-align: center;
}
.terminal-field {
    font-size: 7;
    text-color: #FF343548;
    text-shadow: false;
    background: sprite(data_energistics:textures/guis/states/small_top_surface/small_text_box_0.png);
    focus-overlay: border(1, #FF9AD8FF);
}
.terminal-field:focus { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_text_box.png); }
.terminal-control {
    background: #00000000;
    base-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_button_0.png);
    hover-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_button_1.png);
    pressed-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_button_2.png);
}
.terminal-resize, .transfer-processing {
    base-background: #00000000;
    hover-background: #339AD8FF;
    pressed-background: #559AD8FF;
}
.terminal-tab {
    base-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_horizontal_tab.png, 2, 0, 12, 14);
    hover-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_horizontal_tab_selected.png, 2, 0, 12, 14);
    pressed-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_horizontal_tab_selected.png, 2, 0, 12, 14);
}
.terminal-tab.selected {
    base-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_horizontal_tab_selected.png, 2, 0, 12, 14);
}
.terminal-storage-scroll .__scroller_scroll_container__ { background: #00000000; }
.scroll-rail { background: #FFCBCCD4; }
.scroll-rail-rim { background: #FFF2F2F2; }
.scroll-rail-center { background: #FF9A9FB4; }
.scroll-rail-shadow { background: #FF696D88; }
.terminal-storage-scroll .__scroller_scroll_bar__ {
    base-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_slider_0.png);
    hover-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_slider_1.png);
    pressed-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_slider_1.png);
}
.terminal-storage-scroll.inactive-scroll .__scroller_scroll_bar__ {
    base-background: sprite(data_energistics:textures/guis/states/small_top_surface/small_slider_2.png);
}
.terminal-cell {
    background: sprite(data_energistics:textures/guis/backpack/middle.png);
    base-background: #00000000;
    hover-background: group(#6693FFDE, border(1, #FF57E0BB));
    pressed-background: #8893FFDE;
}
.terminal-cell.embedded-cell { background: #00000000; }
.terminal-cell.selected-recipe { base-background: #6693FFDE; }
.terminal-page.page-crafting { background: sprite(data_energistics:textures/guis/states/background/small_synthesize.png); }
.terminal-page.page-processing { background: sprite(data_energistics:textures/guis/states/background/small_handle.png); }
.terminal-page.page-smithing { background: sprite(data_energistics:textures/guis/states/background/small_forging.png); }
.terminal-page.page-stonecutting { background: sprite(data_energistics:textures/guis/states/background/small_stone_cutting.png); }
.terminal-page.page-anvil { background: sprite(data_energistics:textures/guis/states/background/small_anvil.png); }
.anvil-boost { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_text_box_1.png); }
.terminal-popup { background: group(#FFCCCDD6, border(1, #FFF0F0F3)); z-index: 600; }
.terminal-list .__scroller_view_view-container__ { width: 100%; flex-direction: column; gap-all: 1px; padding-all: 0px; }

.icon-entry { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_storage_synthesis.png); }
.icon-drag { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_close_drag.png); }
.icon-resize { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_zoom.png); }
.icon-tasks { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_maintain.png); }
.icon-sort { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_sort_by_name.png); }
.sort-amount .icon-sort { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_sort_by_amount.png); }
.icon-direction { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_arrow_up_1.png); }
.descending .icon-direction { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_arrow_down_1.png); }
.icon-display { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_storage_synthesis.png); }
.stored-only .icon-display { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_storage.png); }
.craftable-only .icon-display { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_synthesis.png); }
.icon-type { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_type_filter_all.png); }
.icon-network { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_toppin.png); }
.icon-magnet { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_magnet.png); }
.icon-insert { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_storage.png); }
.icon-crafting { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_synthesize.png); }
.icon-processing { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_handle.png); }
.icon-smithing { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_forging.png); }
.icon-stonecutting { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_stone_cutting.png); }
.icon-anvil { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_anvil.png); }
.icon-settings { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_cog.png); }
.icon-encoding { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_coding.png); }
.actual-mode .icon-encoding { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_synthesis.png); }
.icon-transfer { background: sprite(data_energistics:textures/guis/states/small_top_surface/small_synthesis.png); }
