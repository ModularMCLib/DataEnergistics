.platform-editor-input { background: group(#FF9A9FB4, border(-1, #FFF2F2F2)); font-size: 7; text-color: #FF343548; text-shadow: false; }
.platform-editor-preview, .platform-editor-slider { background: group(#FF9A9FB4, border(-1, #FFF2F2F2)); }
.platform-hud-label { font-size: 8; text-shadow: false; adaptive-width: false; adaptive-height: false; text-wrap: wrap; }
